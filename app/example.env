# --- Required ---

# LLM: free Groq key from https://console.groq.com (no billing, no card).
GROQ_API_KEY=

# Email delivery (Gmail SMTP).
MY_EMAIL=your_email@gmail.com
APP_PASSWORD=your_gmail_app_password   # Gmail App Password, not your normal one

# Postgres connection string.
#   Local:  postgresql://postgres:postgres@localhost:5432/ai_news
#   Neon:   postgresql://user:pass@ep-xxx.neon.tech/ai_news?sslmode=require
DATABASE_URL=postgresql://user:pass@localhost:5432/ai_news

# Auto-detected as PRODUCTION when DATABASE_URL contains "render.com". Override here if needed.
ENVIRONMENT=LOCAL

# --- Optional ---

# Alternative LLM providers. Pick ONE — Groq is checked first, then Gemini, then OpenAI.
# GEMINI_API_KEY=
# OPENAI_API_KEY=sk-...
# LLM_BASE_URL=                        # force a custom OpenAI-compatible endpoint

# Webshare residential proxy for youtube-transcript-api. Optional.
# https://www.webshare.io/
WEBSHARE_USERNAME=
WEBSHARE_PASSWORD=

# Tunables
DIGEST_LOOKBACK_HOURS=24
EMAIL_TOP_N=10
# Primary LLM model. Check current Groq availability:
#   https://console.groq.com/docs/models
# Groq (as of 2026-08): openai/gpt-oss-20b, openai/gpt-oss-120b, qwen/qwen3.6-27b
# Gemini: gemini-2.0-flash, gemini-1.5-flash
# OpenAI: gpt-4o-mini, gpt-4o
LLM_MODEL=openai/gpt-oss-20b

# Fallback chain — if the primary model returns 404 model_not_found, the
# agent tries each of these in order (comma-separated). Leave blank to use
# the built-in defaults in app/config.py.
# LLM_MODEL_FALLBACKS=openai/gpt-oss-20b,openai/gpt-oss-120b
